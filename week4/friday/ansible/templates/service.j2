[Unit]
Description=KijaniKiosk {{ inventory_hostname }} service
After=network.target

[Service]
Type=simple
User=kk-service
WorkingDirectory=/opt/kijanikiosk/{{ inventory_hostname }}
EnvironmentFile=/opt/kijanikiosk/config/{{ inventory_hostname }}.env
ExecStart=/bin/bash -c "echo Running {{ inventory_hostname }}"
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target